{
  "_comment": "Theme registry. The display reads this to decide which skin to show today. Each theme's CSS lives in themes/themes.css as a [data-theme=\"key\"] block. To add per-theme art later, drop files in themes/<key>/assets/ and reference them from that CSS block via --deco-* / --bg-image. 'active' windows use MM-DD strings; a window where 'from' > 'to' wraps across New Year. When more than one theme matches today, the one earliest in 'order' wins — so specific holidays beat broad seasons.",

  "order": [
    "halloween",
    "thanksgiving",
    "christmas",
    "end-of-year",
    "testing",
    "summer-school",
    "summer-break",
    "back-to-school",
    "spring",
    "fall",
    "winter",
    "default"
  ],

  "themes": {
    "default": {
      "label": "Staff Board",
      "effect": "none"
    },
    "testing": {
      "label": "Testing Window — Quiet Please",
      "effect": "none",
      "active": [{ "from": "05-15", "to": "05-31" }]
    },
    "end-of-year": {
      "label": "End of the Year!",
      "effect": "confetti",
      "effect_active": [{ "from": "06-10", "to": "06-12" }],
      "active": [{ "from": "05-31", "to": "06-14" }]
    },
    "summer-school": {
      "label": "Summer School",
      "effect": "none",
      "active": [{ "from": "06-15", "to": "07-08" }]
    },
    "summer-break": {
      "label": "Summer Break",
      "effect": "none",
      "active": [{ "from": "07-08", "to": "07-31" }]
    },
    "back-to-school": {
      "label": "Welcome Back!",
      "effect": "none",
      "active": [{ "from": "07-31", "to": "09-15" }]
    },
    "fall": {
      "label": "Fall",
      "active": [{ "from": "09-16", "to": "11-30" }]
    },
    "halloween": {
      "label": "Happy Halloween",
      "effect": "none",
      "active": [{ "from": "10-15", "to": "10-31" }]
    },
    "thanksgiving": {
      "label": "Happy Thanksgiving",
      "effect": "leaves",
      "effect_active": [{ "from": "11-16", "to": "11-27" }],
      "active": [{ "from": "11-18", "to": "11-30" }]
    },
    "christmas": {
      "label": "Happy Holidays",
      "effect": "snow",
      "effect_active": [{ "from": "12-14", "to": "12-26" }],
      "active": [{ "from": "11-01", "to": "12-26" }]
    },
    "winter": {
      "label": "Winter",
      "active": [{ "from": "12-27", "to": "03-20" }]
    },
    "spring": {
      "label": "Spring",
      "effect": "none",
      "active": [{ "from": "03-21", "to": "05-15" }]
    }
  }
}
